{
  "name": "spriteware-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "elm:build": "elm make elm/src/Main.elm --output=public/elm.js --optimize",
    "elm:build:dev": "elm make elm/src/Main.elm --output=public/elm.js",
    "dev": "node scripts/dev.mjs",
    "build": "npm run elm:build && vite build --mode production",
    "build:dev": "npm run elm:build:dev && vite build --minify false --mode development",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/albert-sans": "^5.3.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@wailsio/runtime": "3.0.0",
    "gsap": "^3.15.1"
  },
  "devDependencies": {
    "vite": "^8.2.4"
  }
}
